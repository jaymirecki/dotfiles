{
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "respectGitignore": false,
  "enabledPlugins": {
    "crit@crit": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "low"
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "~/.muster/workspaces/"
    ],
    "allow": [
      "Bash(gh issue *)",
      "Bash(crit *)",
      "Bash(git status *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(just *)",
      "Bash(git log *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git pull *)",
      "Bash(gh pr *)"
    ]
  },
  "hooks": {
    "TaskCompleted": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "[ -z \"$CLAUDE_MUTE_SOUNDS\" ] && afplay ~/.claude/sounds/r2d2_beepbooweep.mp3 2>/dev/null || true",
        "statusMessage": "Task completed"
      }]
    }],
    "PermissionRequest": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "[ -z \"$CLAUDE_MUTE_SOUNDS\" ] && afplay ~/.claude/sounds/r2d2_bewer.mp3 2>/dev/null || true",
        "statusMessage": "Waiting for permission"
      }]
    }],
    "Notification": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "[ -z \"$CLAUDE_MUTE_SOUNDS\" ] && afplay ~/.claude/sounds/r2d2_brrwzzrr.mp3 2>/dev/null || true",
        "statusMessage": "Notification alert"
      }]
    }],
    "Stop": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "[ -z \"$CLAUDE_MUTE_SOUNDS\" ] && afplay ~/.claude/sounds/r2d2_beepbeepboop.mp3 2>/dev/null || true",
        "statusMessage": "Waiting for input",
        "async": true
      }]
    }]
  }
}
